---
import SectionHeader from '../ui/SectionHeader.astro';
import HandleRow from '../ui/HandleRow.astro';
import ResumeLink from '../ui/ResumeLink.astro';
import { site } from '../../config/site';

const handles = [
  { label: 'email', value: site.email, href: `mailto:${site.email}` },
  { label: 'linkedin', value: site.linkedin.replace(/^https:\/\/www\./, '').replace(/\/$/, ''), href: site.linkedin },
  { label: 'github', value: site.github.replace(/^https:\/\//, ''), href: site.github },
  { label: 'based in', value: `${site.location} · ${site.timezone}` },
];
---

<section id="contact" class="py-section px-6" aria-labelledby="section-contact-title">
  <div class="mx-auto max-w-narrow">
    <div data-reveal>
      <SectionHeader
        id="section-contact-title"
        eyebrow="06 — Contact"
        title="Let's talk"
        description="Open to backend, infrastructure, and AI roles. If you're hiring for something interesting, I'd like to hear about it."
      />
    </div>

    <dl data-reveal data-reveal-delay="80">
      {handles.map((handle) => (
        <HandleRow {...handle} />
      ))}
    </dl>

    <div class="mt-8 flex flex-wrap items-center justify-end gap-4" data-reveal data-reveal-delay="160">
      <ResumeLink label="Download résumé" />
      <a
        href={`mailto:${site.email}`}
        class="font-mono-lg text-accent transition-colors duration-fast hover:text-accent-hover hover:underline"
      >
        say hi →
      </a>
    </div>
  </div>
</section>
