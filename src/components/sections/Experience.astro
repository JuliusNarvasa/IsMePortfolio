---
import SectionHeader from '../ui/SectionHeader.astro';
import Tag from '../ui/Tag.astro';
import { yearsExperience } from '../../config/site';
import { employers } from '../../data/experience';
---

<section id="experience" class="py-section px-6" aria-labelledby="section-experience-title">
  <div class="mx-auto max-w-content">
    <div data-reveal>
      <SectionHeader
        id="section-experience-title"
        eyebrow="01 — Experience"
        title="Where I've shipped"
        description={`${yearsExperience} years of production backends for real clients, from first commit to acquisition.`}
      />
    </div>

    <div class="space-y-14">
      {employers.map((employer) => (
        <div>
          {/* Employer header */}
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-border pb-3" data-reveal>
            <div class="flex flex-wrap items-baseline gap-x-3">
              <h3 class="text-h3 text-text">{employer.company}</h3>
              <span class="font-mono-sm uppercase tracking-wider text-text-dim">{employer.kind}</span>
            </div>
            <span class="font-mono text-text-muted">{employer.period}</span>
          </div>

          {/* Engagements on a rail */}
          <ol class="relative space-y-8 lg:pl-10">
            <div class="absolute bottom-2 left-[5px] top-2 hidden w-px bg-border lg:block" aria-hidden="true"></div>
            {employer.engagements.map((e) => (
              <li class="relative" data-reveal>
                <span
                  class:list={[
                    'absolute -left-10 top-2 hidden h-[11px] w-[11px] rounded-full border lg:block',
                    e.outcome ? 'border-accent bg-accent shadow-accent-glow' : 'border-border-strong bg-bg-elevated',
                  ]}
                  aria-hidden="true"
                ></span>

                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
                  <span class="w-20 flex-shrink-0 whitespace-nowrap font-mono text-text-dim">{e.years || '\u00a0'}</span>
                  <div class="flex-1">
                    <p class="text-h4 text-text">
                      {e.project}
                      <span class="text-text-dim mx-1.5">·</span>
                      <span class="text-text-muted">{e.role}</span>
                    </p>
                    <p class="mt-1 text-body text-text-muted">{e.summary}</p>

                    {e.highlights.length > 0 && (
                      <ul class="mt-2 space-y-1">
                        {e.highlights.map((h) => (
                          <li class="flex items-start gap-2 text-body-sm text-text-muted">
                            <span class="mt-0.5 text-accent">›</span>
                            {h}
                          </li>
                        ))}
                      </ul>
                    )}

                    {e.outcome && (
                      <div class="mt-3">
                        <Tag label={e.outcome} dot tone="accent" />
                      </div>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>
