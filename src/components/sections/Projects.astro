---
import SectionHeader from '../ui/SectionHeader.astro';
import ProjectCard from '../ui/ProjectCard.astro';

const projects = [
  {
    slug: 'data-platform',
    title: 'Contact-centre data platform',
    category: 'internal',
    featured: true,
    problem: 'Contact-centre data lived in separate vendor tools (Genesys and Zendesk). The goal: one governed platform for KPI reporting, built and tested without ever touching production data.',
    challenges: [
      'Wire-level mock of both vendor APIs: 22 endpoints, seeded synthetic data, contract tests',
      'Bronze → silver → gold pipelines on Microsoft Fabric, with gold remodeled as a star schema for self-serve Power BI',
      'Repository governance in Terraform: PR plan comments, daily drift checks, apply on merge',
    ],
    tech: ['microsoft-fabric', 'python', 'power-bi', 'terraform', 'wiremock', 'pytest', 'azure', 'github-actions'],
    links: {},
    note: 'internal work · code is private',
    diagram: {
      label: 'Data platform: Genesys and Zendesk data, from live APIs or a 22-endpoint synthetic mock, flows through bronze, silver, and gold lakehouse layers into Power BI.',
      text: `Genesys ─┐
         ├─▶ bronze ─▶ silver ─▶ gold ─▶ Power BI
Zendesk ─┘    raw     cleaned  star schema

  live APIs, or a 22-endpoint synthetic mock`,
    },
  },
  {
    slug: 'isp-billing',
    title: 'ISP billing platform',
    category: 'freelance',
    problem: 'ISPs run on recurring subscriptions, and every failed payment is a customer quietly slipping away. They needed one platform to manage customers and billing across many operators.',
    challenges: [
      'Multi-tenant APIs serving many ISPs from one platform',
      'Stripe and GoCardless payment integrations',
      'Subscription recovery workflows for failed payments',
    ],
    tech: ['multi-tenant', 'apis', 'stripe', 'gocardless', 'billing'],
    links: {},
    note: 'freelance · code is private',
    diagram: {
      label: 'ISP billing platform architecture: multiple ISP tenants call one API, which routes billing to Stripe and GoCardless and feeds failed payments into subscription recovery.',
      text: `ISP A ─┐
ISP B ─┼─▶  API  ─▶  billing ─┬─▶ Stripe
ISP C ─┘     │                └─▶ GoCardless
             ▼
   subscription recovery`,
    },
  },
  {
    slug: 'refuel',
    title: 'Re-Fuel',
    category: 'mobile',
    problem: 'Drivers manually log gas prices and fuel consumption across the Philippines — no easy way to see trends or remember which station was cheapest last week.',
    challenges: [
      'GPS-based auto-capture within 150m',
      'On-device YOLOv8 price-board detection (ONNX)',
      'Offline-first IndexedDB cache',
    ],
    tech: ['react', 'capacitor', 'typescript', 'yolov8', 'onnx', 'csharp', 'dotnet-8', 'postgres'],
    links: {
      demo: 'https://refuel.bambaw-tumba.com',
    },
    screenshot: {
      src: '/images/projects/refuel-home.png',
      alt: 'Re-Fuel mobile app home screen showing gas station price tracking',
      type: 'mobile' as const,
    },
  },
  {
    slug: 'airesumebuilder',
    title: 'AI Resume Builder',
    category: 'web',
    problem: 'Tailoring a resume to every job posting is tedious and error-prone. Generic resumes get filtered out.',
    challenges: [
      'PDF + DOCX resume parsing',
      'Playwright-based LinkedIn scraping',
      'Structured LLM output for tailored CV + cover letter',
    ],
    tech: ['fastapi', 'python', 'react', 'vite', 'tailwindcss', 'playwright', 'openai-api', 'pymupdf'],
    links: {
      demo: 'https://cvmaker.bambaw-tumba.com',
    },
    screenshot: {
      src: '/images/projects/airesumebuilder-home.png',
      alt: 'AI Resume Builder upload step showing file drag-and-drop interface',
      type: 'web' as const,
    },
  },
  {
    slug: 'gpuvrammonitor',
    title: 'GpuVramMonitor',
    category: 'desktop',
    problem: 'Windows has no per-process VRAM tool for AMD GPUs. Task Manager shows only the total; AMD Adrenalin shows only the total.',
    challenges: [
      'Parsing GPU Process Memory performance counter instance names',
      'Resolving PIDs and excluding the inflated dwm.exe reading',
      'Real-time refresh with pause/resume',
    ],
    tech: ['csharp', 'wpf', 'dotnet-8', 'windows', 'performance-counters'],
    links: {
      github: 'https://github.com/JuliusNarvasa/GPUVramMonitor',
    },
    screenshot: {
      src: '/images/projects/gpuvrammonitor.png',
      alt: 'GpuVramMonitor showing per-process VRAM usage on AMD Radeon RX 7800 XT',
      type: 'web' as const,
    },
  },
];
---

<section id="projects" class="py-section px-6" aria-labelledby="section-projects-title">
  <div class="mx-auto max-w-content">
    <div data-reveal>
      <SectionHeader
        id="section-projects-title"
        eyebrow="02 — Work"
        title="Selected work"
        description="Client work up front, side projects after. Each one solved a real problem for someone, usually me."
      />
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {projects.map((project, i) => (
        <div class:list={[project.featured && 'md:col-span-2']} data-reveal data-reveal-delay={String((i % 2) * 80)}>
          <ProjectCard {...project} />
        </div>
      ))}
    </div>
  </div>
</section>
