---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Stack from '../components/sections/Stack.astro';
import Personality from '../components/sections/Personality.astro';
import Lab from '../components/sections/Lab.astro';
import Contact from '../components/sections/Contact.astro';
---

<Layout>
  <Nav />
  {/* Skip to content */}
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-[#0B0F14] focus:font-mono focus:shadow-accent-glow">
    Skip to content
  </a>
  <main id="main">
    {/* Proof first (who, what level, what shipped), personality second. */}
    <Hero />
    <Experience />
    <Projects />
    <Stack />
    <Personality />
    <Lab />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  import '../scripts/slideshow.ts';
</script>
