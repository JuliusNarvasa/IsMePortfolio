---
import Layout from '../layouts/Layout.astro';
import PortfolioApp from '../components/PortfolioApp';

// Build-time stamp. Astro builds the page once; this is the build's "last
// updated" marker. Forwarded to <Footer> for the "last updated: YYYY-MM-DD"
// line. A real CI pipeline would source this from a build env var, but
// `new Date()` at build time is close enough for a single-developer site.
const buildDate = new Date().toISOString().slice(0, 10);
---

<Layout>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent focus:font-mono focus:shadow-accent-glow">
    Skip to content
  </a>
  <PortfolioApp client:load buildDate={buildDate} />
</Layout>
